<!DOCTYPE html>
<html lang="es" data-marca="@(ViewData["Marca"] ?? "orange")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · CDM Auditorías Calidad</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    @* Antes de la hoja de estilos: pone data-tema en <html> y así no parpadea al cargar. *@
    <script src="~/js/tema.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="barra-carga" aria-hidden="true"></div>
    @RenderBody()
    <button type="button" class="pres-salir" data-presentar-salir>@Iconos.Svg("cerrar") Salir de la presentación</button>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
