@model TableroModelo
@* «T0 y planes de acción» (debajo de la tira de indicadores, que es la de todas las páginas): por técnico de calidad /
   auditor, sus auditorías, las que tienen T0 y cuántas están en [Reporting].[pdc].[Reportar_T0] (y allí, con plan).
   Solo piezas que ya existían: .aviso, table.ranking[data-mapa] con TOTAL al pie, .crono-tarjeta con _LineasGaia,
   .hbarras.libre, .chip y .pastilla-dato. *@
@{
    var t = Model.T0!;
    var f = Model.Filtros;
    var url = "/" + Model.Pagina.Clave;
    var porVista = Model.Vista switch { Vista.Dia => "día", Vista.Semana => "semana", _ => "mes" };
    var tituloEje = Model.Vista switch { Vista.Dia => "Día", Vista.Semana => "Semana", _ => "Mes" };
    var puntos = t.Evolucion;
    var grafico = new GraficoGaia(
        puntos.Select(p => p.Etiqueta).ToList(), puntos.Select(p => p.Detalle).ToList(), puntos.Select(p => p.Cantidad).ToList(),
        [new SerieGaia("% en Reportar_T0", "serie-a", puntos.Select(p => p.Nota).ToList())])
    {
        NombreVolumen = "Auditorías con T0",
        Dia = Model.Vista == Vista.Dia,
        AnchoEstimado = 420,
        MaxEtiquetasX = 10,
        Descripcion = "% de auditorías con T0 que están en Reportar_T0 por " + porVista,
    };
    var maxSituacion = Math.Max(1, t.Situaciones.Select(s => s.Cantidad).DefaultIfEmpty(0).Max());
    string Pct(int parte, int total) => Formato.Porcentaje(total > 0 ? (double)parte / total : null);
    var aud = t.PorAuditor;
    var totalAuditorias = aud.Sum(a => a.Auditorias);
    var totalPropios = aud.Sum(a => a.ReportesPropios);
}
@if (t.Error is { } error)
{
    <div class="aviso" role="alert">
        @Iconos.Svg("alerta")
        <span>No se pudieron leer las T0 ni Reportar_T0; el resto del informe sigue. <small>@error</small></span>
    </div>
}

@if (aud.Count == 0)
{
    <section class="tarjeta">
        <p class="vacio">Sin auditorías con estos filtros</p>
    </section>
}
else
{
    <section class="tarjeta">
        <header class="tarjeta-cabecera">
            <h2>Por técnico de calidad / auditor</h2>
            <span class="tarjeta-nota">Sus auditorías, cuántas tienen T0 y cuántas de esas están en Reportar_T0 · primero quien más T0 tiene · pulsa un auditor para filtrar</span>
        </header>
        <div class="tabla-contenedor alta">
            <table class="ranking con-puesto" data-mapa>
                <thead>
                    <tr>
                        <th scope="col"><button type="button" class="ordenar">Auditor</button></th>
                        <th scope="col"><button type="button" class="ordenar">Cargo</button></th>
                        <th scope="col" class="num" title="Todas sus auditorías (WEB e ICEBERG), como en General"><button type="button" class="ordenar">Auditorías</button></th>
                        <th scope="col" class="num" title="Auditorías de ICEBERG con «Tolerancia 0»"><button type="button" class="ordenar">Con T0</button></th>
                        <th scope="col" class="num"><button type="button" class="ordenar">% con T0</button></th>
                        <th scope="col" class="num" title="De sus T0, las que están en Reportar_T0"><button type="button" class="ordenar">En Reportar_T0</button></th>
                        <th scope="col" class="num" data-sentido="-1"><button type="button" class="ordenar">Sin reportar</button></th>
                        <th scope="col" class="num" data-sentido="1"><button type="button" class="ordenar">% reportadas</button></th>
                        <th scope="col" class="num" title="De las reportadas, las gestionadas con plan de acción"><button type="button" class="ordenar">Con plan</button></th>
                        <th scope="col" class="num" title="Filas de Reportar_T0 con este auditor en estas fechas (incluye T0 de formularios WEB u otras fuentes)"><button type="button" class="ordenar">Sus reportes</button></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in aud)
                    {
                        <tr>
                            <td class="celda-nombre" data-valor="@a.Nombre">
                                <a class="nombre-fila" href="@(url + f.Alternar("auditor", a.Nombre).Consulta())" data-parcial
                                   title="@(a.Marcado ? "Pulsa para quitar el filtro" : "Pulsa para filtrar por este auditor")"><span class="nombre-texto">@a.Nombre</span></a>
                            </td>
                            <td data-valor="@a.Cargo">@(a.Cargo ?? CalculadoraTablero.EnBlanco)</td>
                            <td class="num barra-volumen" data-valor="@a.Auditorias">@Formato.Entero(a.Auditorias)</td>
                            <td class="num" data-valor="@a.ConT0">@Formato.Entero(a.ConT0)</td>
                            <td class="num" data-valor="@Formato.Crudo(a.PctT0)">@Formato.Porcentaje(a.PctT0)</td>
                            <td class="num" data-valor="@a.Reportadas">@Formato.Entero(a.Reportadas)</td>
                            <td class="num" data-valor="@a.SinReportar">@Formato.Entero(a.SinReportar)</td>
                            <td class="num" data-valor="@Formato.Crudo(a.PctReportadas)">@(a.ConT0 > 0 ? Formato.Porcentaje(a.PctReportadas) : "—")</td>
                            <td class="num" data-valor="@a.ConPlan">@Formato.Entero(a.ConPlan)</td>
                            <td class="num" data-valor="@a.ReportesPropios">@Formato.Entero(a.ReportesPropios)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="total">
                        <td>TOTAL</td>
                        <td>@Formato.Entero(aud.Count) auditores</td>
                        <td class="num">@Formato.Entero(totalAuditorias)</td>
                        <td class="num">@Formato.Entero(t.Total)</td>
                        <td class="num">@Pct(t.Total, totalAuditorias)</td>
                        <td class="num">@Formato.Entero(t.Reportadas)</td>
                        <td class="num">@Formato.Entero(t.SinReportar)</td>
                        <td class="num">@Pct(t.Reportadas, t.Total)</td>
                        <td class="num">@Formato.Entero(t.ConPlan)</td>
                        <td class="num">@Formato.Entero(totalPropios)</td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <p class="nota-ns">
            Las T0 solo se marcan en ICEBERG (los formularios WEB no tienen ese campo), así que «% con T0» es sobre todas sus auditorías.
            Una T0 cuenta como reportada aunque la subiera otra persona. «Sus reportes» son las filas de Reportar_T0 con su nombre en estas fechas:
            @if (t.ReportesSinAuditoria > 0)
            {
                <text>@Formato.Entero(t.ReportesSinAuditoria) de las filas de estas fechas no salen de una auditoría T0 de ICEBERG (formularios WEB, team leaders…).</text>
            }
            else
            {
                <text>todas salen de una auditoría T0 de ICEBERG.</text>
            }
        </p>
    </section>

    @if (t.Total > 0)
    {
        <div class="rejilla-2">
            <section class="tarjeta crono-tarjeta">
                <header class="tarjeta-cabecera">
                    <h2>Auditorías con T0 en Reportar_T0</h2>
                    <span class="tarjeta-nota">% reportadas por @porVista, con las auditorías con T0 detrás · deberían estar todas</span>
                </header>
                @await Html.PartialAsync("_LineasGaia", grafico)
                <div class="titulo-eje">@tituloEje</div>
            </section>

            <section class="tarjeta">
                <header class="tarjeta-cabecera">
                    <h2>En qué punto está cada T0</h2>
                    <span class="tarjeta-nota">De la auditoría a Reportar_T0 y al plan · filtra una con «Situación» en el panel</span>
                </header>
                <div class="hbarras libre">
                    @foreach (var s in t.Situaciones)
                    {
                        var fraccion = Formato.Coord(Math.Max(0.006, (double)s.Cantidad / maxSituacion));
                        <div class="hbarra" title="@TextosT0.Texto(s.Situacion) · @Formato.Entero(s.Cantidad) · @TextosT0.Explicacion(s.Situacion)@(s.Detalle is null ? "" : " · " + s.Detalle)">
                            <span class="hbarra-nombre">
                                <span>@TextosT0.Texto(s.Situacion)</span>
                                <span class="sub-ns envuelve">@(s.Detalle ?? TextosT0.Explicacion(s.Situacion))</span>
                            </span>
                            <span class="hbarra-pista"><span class="hbarra-relleno @TextosT0.Tono(s.Situacion)" style="--fraccion:@fraccion"></span><span class="hbarra-valor">@Formato.Entero(s.Cantidad)</span></span>
                            <span class="hbarra-media-valor">@Pct(s.Cantidad, t.Total)</span>
                        </div>
                    }
                </div>
                <p class="nota-ns">La regla: toda auditoría con T0 tiene que estar en Reportar_T0 y gestionarse con plan de acción. Las gestiones salen de Reportar_T0 (acción y número del plan).</p>
            </section>
        </div>

        <div class="rejilla-2">
            @foreach (var (titulo, nota, campo, filasTabla) in new[]
            {
                ("Por sector", "Pulsa un sector para filtrar · el semáforo compara el % reportadas", "sector", t.PorSector),
                ("Por plantilla", "Primero las que más T0 sin reportar tienen · pulsa una para filtrar", "plantilla", t.PorPlantilla),
            })
            {
                <section class="tarjeta">
                    <header class="tarjeta-cabecera">
                        <h2>@titulo</h2>
                        <span class="tarjeta-nota">@nota</span>
                    </header>
                    <div class="tabla-contenedor">
                        <table class="ranking" data-mapa>
                            <thead>
                                <tr>
                                    <th scope="col"><button type="button" class="ordenar">@(campo == "sector" ? "Sector" : "Plantilla")</button></th>
                                    <th scope="col" class="num"><button type="button" class="ordenar">Con T0</button></th>
                                    <th scope="col" class="num"><button type="button" class="ordenar">En Reportar_T0</button></th>
                                    <th scope="col" class="num" data-sentido="1"><button type="button" class="ordenar">% reportadas</button></th>
                                    <th scope="col" class="num"><button type="button" class="ordenar">Sin reportar</button></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in filasTabla)
                                {
                                    <tr>
                                        <td class="celda-nombre" data-valor="@s.Nombre">
                                            <a class="nombre-fila" href="@(url + f.Alternar(campo, s.Nombre).Consulta())" data-parcial
                                               title="@(s.Marcado ? "Pulsa para quitar el filtro" : "Pulsa para filtrar")"><span class="nombre-texto">@s.Nombre</span></a>
                                        </td>
                                        <td class="num barra-volumen" data-valor="@s.Total">@Formato.Entero(s.Total)</td>
                                        <td class="num" data-valor="@s.Reportadas">@Formato.Entero(s.Reportadas)</td>
                                        <td class="num" data-valor="@Formato.Crudo(s.PctReportadas)">@Formato.Porcentaje(s.PctReportadas)</td>
                                        <td class="num" data-valor="@s.SinReportar">@Formato.Entero(s.SinReportar)</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="total">
                                    <td>TOTAL</td>
                                    <td class="num">@Formato.Entero(t.Total)</td>
                                    <td class="num">@Formato.Entero(t.Reportadas)</td>
                                    <td class="num">@Pct(t.Reportadas, t.Total)</td>
                                    <td class="num">@Formato.Entero(t.SinReportar)</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </section>
            }
        </div>

        <section class="tarjeta">
            <header class="tarjeta-cabecera">
                <h2>Detalle de auditorías con T0</h2>
                <span class="tarjeta-nota">Primero las que no están en Reportar_T0, de la más reciente a la más antigua · @(t.DetalleTotal > t.Detalle.Count ? $"se ven {Formato.Entero(t.Detalle.Count)} de {Formato.Entero(t.DetalleTotal)}; el Excel lleva todas" : "el Excel lleva además la fila completa de Reportar_T0")</span>
            </header>
            <div class="tabla-contenedor alta">
                <table class="ranking">
                    <thead>
                        <tr>
                            <th scope="col"><button type="button" class="ordenar">Agente</button></th>
                            <th scope="col"><button type="button" class="ordenar">Auditoría</button></th>
                            <th scope="col"><button type="button" class="ordenar">Auditor</button></th>
                            <th scope="col"><button type="button" class="ordenar">Situación</button></th>
                            <th scope="col"><button type="button" class="ordenar">Gestión</button></th>
                            <th scope="col"><button type="button" class="ordenar">Infracción</button></th>
                            <th scope="col"><button type="button" class="ordenar">Plantilla</button></th>
                            <th scope="col"><button type="button" class="ordenar">Team</button></th>
                            <th scope="col"><button type="button" class="ordenar">ID llamada</button></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in t.Detalle)
                        {
                            var r = a.Reporte;
                            <tr>
                                <td class="celda-nombre" data-valor="@a.Agente">
                                    <div class="nombre-fila">
                                        <span class="nombre-texto">@(a.Agente ?? CalculadoraTablero.EnBlanco)</span>
                                        @if (a.Legajo is { } legajo)
                                        {
                                            <span class="pastilla-dato" title="Legajo">@legajo</span>
                                        }
                                    </div>
                                </td>
                                <td data-valor="@a.Fecha.ToString("yyyy-MM-dd")">@Formato.Fecha(a.Fecha)</td>
                                <td title="@a.CargoAuditor">@(a.NombreAuditor ?? CalculadoraTablero.EnBlanco)</td>
                                <td data-valor="@((int)a.Situacion)" title="@TextosT0.Explicacion(a.Situacion)"><span class="chip @TextosT0.Chip(a.Situacion)">@TextosT0.Texto(a.Situacion)</span></td>
                                <td title="@(r is null ? "No está en Reportar_T0" : $"Reportar_T0 {r.Id} · encontrada por {a.Cruce?.ToLowerInvariant()} · reportada el {Formato.FechaHora(r.Reporte)} por {r.NombreAuditor}" + (r.DiasGestion is { } d ? $" · gestionada en {TextosT0.Dias(d)}" : ""))">@TextosT0.Gestion(r)</td>
                                <td title="@a.Infraccion">@TextosT0.Corto(a.Infraccion)</td>
                                <td>@(a.Plantilla ?? CalculadoraTablero.EnBlanco)</td>
                                <td>@(a.Team ?? CalculadoraTablero.EnBlanco)</td>
                                <td>@(a.IdLlamada ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    <section class="tarjeta">
        <header class="tarjeta-cabecera"><h2>Cómo se une cada auditoría con Reportar_T0</h2></header>
        <ul class="lista-ns">
            <li><b>Auditorías</b>: las de General (WEB e ICEBERG) en las fechas y filtros elegidos.</li>
            <li><b>Con T0</b>: ICEBERG, <code>Calidad.PlantillaCalidadUnificada</code> con la columna «Tolerancia 0» rellena (ni vacía ni «N/A»). Los formularios WEB no tienen campo de T0.</li>
            <li><b>En Reportar_T0</b>: la auditoría se busca en <code>[Reporting].[pdc].[Reportar_T0]</code>, primero por el ID de la llamada (sale de las respuestas de la plantilla: «Call ID», «ID llamada», «ID de Grabación», «ID Conversacion»); si no, por el mismo agente y el mismo auditor con el reporte entre 1 día antes y 15 después de la auditoría.</li>
            <li><b>Plan de acción</b>: la acción y el número del plan que dice Reportar_T0 («Plan de acción», «Registro de Falta», «Agente dado de baja», «Sin acción»). No se usa ninguna otra tabla de T0 ni de planes.</li>
        </ul>
    </section>
}
